# You don't need this file to test the app - with no .env.local, the app
# automatically reads from public/data/applications.json (test mode), and
# every action (save decision, accept declaration, shortlist, etc.) works
# against an in-memory copy of that data.
#
# When your backend is deployed, copy this file to .env.local and set:
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api
# ^ the moment this is set, lib/api.ts switches every function from test
# mode to real HTTP requests against your backend. No other code changes.

# Optional: only set this if your backend requires a bearer token.
# Note: NEXT_PUBLIC_ vars are visible in the browser - fine for a shared/service
# token, but do not put a private secret here. See lib/api.ts for details.
# NEXT_PUBLIC_API_TOKEN=

SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID

BLOCKCHAIN_PRIVATE_KEY=YOUR_WALLET_PRIVATE_KEY

FUNDING_REGISTRY_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS